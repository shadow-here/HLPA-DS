# ======================================================================
# HLPA-DS environment configuration.
# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# the secrets. The scripts\setup.ps1 helper can generate the secrets for you.
# NEVER commit your real .env to version control.
# ======================================================================

# --- Secrets (REQUIRED - no safe defaults) ---------------------------------
# JWT signing key for login sessions. Use a long random string (>= 32 chars).
JWT_SECRET=change-me-to-a-long-random-string-change-me

# Key used to fingerprint (never store) submitted passwords. Random string.
REDACTION_KEY=change-me-to-another-random-string

# Shared token between the API and the decoy controller sidecar.
CONTROLLER_TOKEN=change-me-to-a-random-token

# --- Initial accounts (created on first API start) -------------------------
# Change these before any shared use. Passwords must be >= 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-Admin-2026!
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=ChangeMe-Analyst-2026!
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=ChangeMe-Viewer-2026!

# --- Lab network ----------------------------------------------------------
# Decoys must have addresses inside this range (matches docker-compose lab_net).
LAB_CIDR=10.66.0.0/24

# --- Host ports (published on 127.0.0.1 only, except the dashboard) --------
FRONTEND_PORT=8080          # open http://localhost:8080 in your browser
COWRIE_SSH_PORT=2222        # 127.0.0.1:2222 -> decoy SSH
COWRIE_TELNET_PORT=2223     # 127.0.0.1:2223 -> decoy Telnet
CANARY_FTP_PORT=2121
CANARY_MYSQL_PORT=13306
CANARY_REDIS_PORT=16379
HTTP_DECOY_PORT=8888        # 127.0.0.1:8888 -> decoy web console

# Set to true only if you serve the dashboard over HTTPS (secure cookies).
COOKIE_SECURE=false
